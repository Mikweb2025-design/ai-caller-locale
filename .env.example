# Copia questo file in .env e riempi i valori. Il file .env non va mai condiviso né messo su GitHub.
# Voce e ascolto girano in locale su questo Mac. Il testo della conversazione va invece al servizio scelto per il cervello
# (Claude Code, oppure un servizio compatibile OpenAI, vedi pannello admin, scheda Cervello): quel servizio può richiedere un accesso o una chiave.

# --- Server ---
PORTA=5050
LOG_CONSERVAZIONE_GIORNI=30
URL_PUBBLICO=              # solo per Twilio: indirizzo pubblico del server, es. https://receptionist.tuodominio.it
SEGRETO=                   # vuoto = il server risponde solo a localhost e rifiuta Host non locali e intestazioni di proxy/tunnel. Per internet: stringa lunga e casuale, obbligatoria
HOST=127.0.0.1             # indirizzo su cui ascolta il server; 0.0.0.0 apre alla rete (solo dietro un proxy https e con SEGRETO)
DATI_DIR=                  # cartella di impostazioni e appuntamenti; vuoto = ./dati (permessi 700; i file 600). Per istanze di prova separate
ALLOW_PRIVATE_FETCH=       # 1 = "Importa dal sito" può leggere anche indirizzi di reti private/locali (di default sono bloccati contro l'SSRF); il server stesso resta escluso

# --- Il cervello: Claude Code ---
CLAUDE_MODELLO=haiku       # haiku = il più pronto al telefono (anche sonnet, opus...)
CLAUDE_IMPEGNO=low         # low = il più pronto (~0,65 s); medium o high ragiona di più ma risponde più tardi
CLAUDE_COMANDO=claude      # percorso del comando claude, se non è nel PATH

# --- Il cervello: OpenCode (alternativa a Claude Code) ---
OPENCODE_COMANDO=opencode  # percorso del comando opencode, se non è nel PATH
OPENCODE_AGENTE=build      # agente usato per rispondere
OPENCODE_CARTELLA=         # cartella di lavoro dell'agente; vuoto = <tmp>/ai-caller-opencode
OPENCODE_URL=              # indirizzo del server OpenCode; vuoto = lo ricava da `opencode service status`

# --- Motore vocale locale (motore/motore.py) ---
MOTORE_PORTA=5051
MOTORE_URL=                # dove il server trova il motore; vuoto = http://127.0.0.1:<MOTORE_PORTA>
STT_MODELLO=mlx-community/parakeet-tdt-0.6b-v3          # oppure un modello faster-whisper: small, large-v3-turbo...
TTS_MODELLO=               # vuoto = la voce in voci/receptionist.wav, clonata col modello Base 0.6B
TTS_VOCE=ryan              # solo senza campione: speaker CustomVoice (ryan, aiden, serena, vivian...)
TTS_TEMPERATURA=0.72       # più naturale e viva senza diventare teatrale
TTS_TOP_P=0.93             # varietà controllata: sotto 1 evita cadenze improbabili
TTS_TOP_K=40               # alternative considerate a ogni passo
TTS_RIPETIZIONE=1.08       # evita ripetizioni e code vocali
TTS_SEME=18                # rende timbro, intensità e cadenza stabili anche dopo i riavvii
TTS_ISTRUZIONI=            # istruzioni di stile, solo per i modelli CustomVoice (senza campione di voce); vuoto = nessuna
# un altro campione di voce: python3 motore/disegna-voce.py, oppure una registrazione tua
TTS_RIF_AUDIO=             # file wav a 24 kHz, 5-15 secondi
TTS_RIF_TESTO=             # cosa si dice nel campione
MOTORE_KEEPWARM_S=300      # dopo questi secondi inattivi riscalda STT/TTS; 0 = off, minimo attivo 60 s (usa periodicamente CPU/GPU)
MOTORE_STT_AVVIO_TIMEOUT_S=120  # attesa massima per caricare e scaldare il riconoscimento vocale; minimo 30 s

# servizi launchd da spegnere mentre il motore è acceso; per sicurezza sono accettate solo queste due label
SPEGNI_SERVIZI=com.qwen3tts.8091,com.qwen3tts.8092
MOTORE_CONTROLLO_SERVIZI_S=60  # ricontrolla e rispegne se un watchdog li riavvia; 0 = off, minimo attivo 30 s

# --- Turni ---
VAD_SOGLIA=700             # energia sopra cui è voce (alzala se c'è rumore di fondo)
VAD_SILENZIO_MS=750        # silenzio dopo cui il cliente ha finito di parlare
VAD_INIZIO_MS=120          # voce continua per dire che il cliente sta parlando
VAD_MINIMO_MS=250          # frasi più corte di così sono rumore
VAD_INTERRUZIONE_MS=500    # voce continua per interrompere il receptionist mentre parla
VAD_SOGLIA_WEB=600         # come VAD_SOGLIA, per il microfono del browser (più basso)
VAD_INTERRUZIONE_MS_WEB=350  # come VAD_INTERRUZIONE_MS, per il browser (l'eco la toglie il browser)
VAD_INTERRUZIONE_FATTORE=1.6      # quanto la voce deve superare la soglia per zittire il receptionist
VAD_INTERRUZIONE_FATTORE_WEB=1.25 # lo stesso per il browser
VAD_GRAZIA_MS=350          # dopo il silenzio la frase resta aperta un attimo, mentre parte la trascrizione
VAD_GRAZIA_MS_WEB=500      # lo stesso per il browser
RIEMPITIVO_S=-1            # se Claude tarda, dopo questi secondi dice "Sì, un attimo." (-1 = mai)
TASTIERA_ATTESA=1          # suoni d'ufficio in sottofondo (attesa e sotto la voce): valore di partenza, poi si regge dal pannello (scheda Suoni); 0 = disattivati
TASTIERA_VOLUME=0.025      # volume da 0 a 0.04; viene limitato automaticamente per non disturbare il VAD; nel pannello: scheda Suoni

# --- Il receptionist ---
NOME_RECEPTIONIST=Luca
GENERE_RECEPTIONIST=m      # m o f, per l'italiano ("sono pronto/pronta")

# --- Twilio (facoltativo: si imposta anche dal pannello admin, scheda Telefono) ---
TWILIO_NUMERO=             # il numero che risponde, es. +15551234567
TWILIO_ACCOUNT_SID=        # questi tre servono per verificare le credenziali, collegare il numero, "Chiamami" e gli SMS (dal pannello admin)
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=         # Auth Token primario dell'account (anche se per le API usi una API Key): verifica la firma X-Twilio-Signature delle chiamate in arrivo. Consigliato; senza, il webhook accetta chiunque conosca l'indirizzo segreto
TWILIO_API_BASE=           # solo per i test (prove/finto-twilio-api.mjs): al posto di https://api.twilio.com
CON_SMS=0                  # 1 = il receptionist manda l'SMS di conferma a fine prenotazione
